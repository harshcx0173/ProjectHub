# ==========================================
# Project Hub - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# .env.local is strictly gitignored.
# ==========================================

# Supabase Cloud Development Project (Required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application Identity & Branding
NEXT_PUBLIC_APP_NAME=Project Hub
NEXT_PUBLIC_COMPANY_NAME=Hydrated Studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First Admin Bootstrap Email
ADMIN_BOOTSTRAP_EMAIL=wp34.department@gmail.com

# File Storage Configuration (Phase 1: supabase)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_NAME=project-files
